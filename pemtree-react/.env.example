# Supabase (opcional: sin estas variables las funciones de comunidad se desactivan de forma segura)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# URL de la app comunitaria (Zanate) que emite la sesión SSO.
# En producción: https://zanate.pages.dev
# En desarrollo: http://localhost:3000
VITE_COMMUNITY_AUTH_URL=https://zanate.pages.dev

# Opcionales para administración, alertas y Web Push
# VITE_ADMIN_UID=uuid-del-administrador
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/tu-form-id
# VITE_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
